configuration {
    show-icons: true;
    drun-display-format: "{icon}  {name}";
}

* {
    font: "JetBrainsMono Nerd Font 13";
    bg: #0e0e13ee;
    bg-alt: #181922ee;
    fg: #eef2ffff;
    accent: #cbbdffff;
    selected: #ffffff12;
    border-soft: #ffffff14;
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 760px;
    border: 1px;
    border-color: @border-soft;
    border-radius: 24px;
    background-color: @bg;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 18px;
    padding: 28px;
    background-color: transparent;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @bg-alt;
    border-radius: 18px;
    padding: 14px;
}

prompt {
    text-color: @accent;
}

entry {
    text-color: @fg;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
    spacing: 10px;
    scrollbar: false;
    background-color: transparent;
}

element {
    orientation: horizontal;
    border-radius: 16px;
    padding: 12px;
    background-color: transparent;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @selected;
    text-color: @fg;
}

element-icon {
    size: 28px;
    margin: 12px;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}

element-text selected {
    text-color: @fg;
}
