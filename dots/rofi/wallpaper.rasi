configuration {
    show-icons: true;
}

* {
    font: "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color: #edf2ff;
}

window {
    width: 940px;
    height: 270px;
    border: 1px;
    border-color: rgba(78, 183, 255, 0.58);
    background-color: rgba(5, 7, 11, 0.94);
    border-radius: 28px;
    padding: 0px;
}

mainbox {
    spacing: 0px;
    padding: 12px 18px;
    children: [ listview ];
}

listview {
    columns: 4;
    lines: 1;
    fixed-columns: true;
    spacing: 16px;
    padding: 0px;
    scrollbar: false;
    cycle: false;
    fixed-height: true;
}

element {
    orientation: vertical;
    padding: 8px;
    border: 0px;
    border-radius: 22px;
    background-color: transparent;
}

element selected {
    background-color: rgba(12, 16, 26, 0.92);
    border: 2px;
    border-color: rgba(78, 183, 255, 0.98);
}

element-icon {
    size: 175px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    margin: 0px;
    border-radius: 18px;
}

element-text {
    margin: 0px;
    padding: 0px;
    text-color: rgba(0, 0, 0, 0%);
    font: "JetBrainsMono Nerd Font 1";
}
